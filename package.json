{
  "name": "wappy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "desktop": "turbo run desktop --filter=client",
    "test": "turbo run test",
    "performance": "pnpm --filter @wappy/api build && node apps/server/scripts/performance.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
