{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "reports": "node --env-file-if-exists=.env src/review-reports.ts"
  },
  "dependencies": {
    "@wappy/api": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
