HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/wappy.sqlite
# Comma-separated browser origins. Tauri and localhost:1420 are allowed by default.
# ALLOWED_ORIGINS=https://your-web-client.example
# Only behind one trusted reverse proxy; block direct access to the API port.
# TRUST_PROXY=1

# Optional Kakao login. Register this exact Redirect URI in Kakao Developers.
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://wappy-api.waps.im/auth/kakao/callback
