{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wappy",
  "version": "1.2.1",
  "identifier": "com.wappy.client",
  "build": {
    "beforeDevCommand": "pnpm --filter @wappy/api build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @wappy/api build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Wappy",
        "width": 320,
        "height": 760,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": false,
        "backgroundThrottling": "disabled",
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "label": "desktop",
        "title": "Wappy Characters",
        "url": "index.html?view=desktop",
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "noRedirectionBitmap": true,
        "backgroundThrottling": "disabled",
        "visibleOnAllWorkspaces": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/psvm203/wappy/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
