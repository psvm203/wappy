{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-minimize",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/psvm203/wappy/issues/new" },
        { "url": "https://*/auth/kakao/authorize[?]state=*" },
        { "url": "http://localhost:*/auth/kakao/authorize[?]state=*" },
        { "url": "http://127.0.0.1:*/auth/kakao/authorize[?]state=*" },
        { "url": "http://[[]::1[]]:*/auth/kakao/authorize[?]state=*" }
      ]
    }
  ]
}
